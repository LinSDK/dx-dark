<UserControl x:Class="DxDark.App.Controls.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <TextBox x:Name="Box"
                 MinWidth="0"
                 MinHeight="0"
                 Padding="8,4,26,4"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Right" />
        <Grid Width="20" Margin="0,3,4,3" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <RepeatButton x:Name="UpButton" Style="{StaticResource SpinButton}" Content="&#xE70E;" Click="OnUp" />
            <RepeatButton x:Name="DownButton" Grid.Row="1" Style="{StaticResource SpinButton}" Content="&#xE70D;" Click="OnDown" />
        </Grid>
    </Grid>
</UserControl>
