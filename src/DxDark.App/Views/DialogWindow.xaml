<Window x:Class="DxDark.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Foreground="{StaticResource TextBrush}">
    <!-- Dims the window it belongs to, like the settings sheet; the card sits in the middle. -->
    <Grid x:Name="Scrim" Background="#A6000000" MouseLeftButtonDown="OnScrimClick">
        <Border x:Name="Card" Width="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="24,20,24,20" MouseLeftButtonDown="OnCardClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Title}" FontSize="17" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="InputBox" Margin="0,16,0,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,8,0" Padding="16,7" IsCancel="True" />
                    <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="OK" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
