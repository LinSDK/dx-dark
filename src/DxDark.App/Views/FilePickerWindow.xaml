<Window x:Class="DxDark.App.Views.FilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Foreground="{StaticResource TextBrush}">
    <Grid x:Name="Scrim" Background="#A6000000">
        <Border x:Name="Card" Width="800" Height="540" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="20,18,20,18" MouseLeftButtonDown="OnCardClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource Title}" FontSize="17" Margin="0,0,0,14" />

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13"
                            ToolTip="Back" Click="OnBack" />
                    <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE74A;" FontSize="13"
                            ToolTip="Up one folder" Click="OnUp" Margin="2,0,8,0" />
                    <TextBox x:Name="PathBox" VerticalContentAlignment="Center" ToolTip="Folder (type a path and press Enter)" />
                </DockPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" IsCancel="True" MinWidth="96" Padding="16,7" Margin="0,0,8,0" />
                        <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="Open" Click="OnOk" />
                    </StackPanel>
                    <TextBlock x:Name="FilterText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="File name" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="NameBox" VerticalContentAlignment="Center" Margin="0,0,14,0" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="184" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="Places" Background="Transparent" BorderThickness="0" SelectionChanged="OnPlaceSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Width="22" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0" Padding="4" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnEntrySelected" MouseDoubleClick="OnEntryDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Width="22" Foreground="{Binding GlyphBrush}" />
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
